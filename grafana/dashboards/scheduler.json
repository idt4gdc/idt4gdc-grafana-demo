        "target": {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-ops"
          },
          "rawSql": "SELECT\n  js.window_start AS time,\n  js.window_end   AS \"timeEnd\",\n  ('Schedulable window for #' || js.id::text) AS text,\n  'window' AS tags\nFROM job_submissions js\nWHERE ${job_id:raw}::integer != 0\n  AND js.id = ${job_id:raw}::integer\n  AND js.window_start IS NOT NULL\n  AND js.window_end IS NOT NULL",
          "format": "table",
          "refId": "AnnoWindow"
        },
