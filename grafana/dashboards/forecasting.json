        "textMode": "value_and_name"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-ops"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT NOW() AS time,\n  COALESCE(ROUND(SUM(forecast_wh)::NUMERIC, 1), 0) AS value\nFROM forecast_generation\nWHERE ts BETWEEN NOW() - INTERVAL '2 years' AND NOW() - INTERVAL '2 years' + INTERVAL '1 hour'\n  AND ss_id = ${solar_panel}::INTEGER",
          "refId": "A"
        }
      ],
      "title": "Next-Hour Forecast",
      "type": "stat"
    },
